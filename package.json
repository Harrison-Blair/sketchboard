{
  "name": "sketchboard",
  "version": "0.1.0",
  "description": "Local design canvas for coding agents: live HTML boards, pointing feedback, and a CLI.",
  "type": "module",
  "license": "MIT",
  "author": "Harrison Blair",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Harrison-Blair/sketchboard.git"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "sketchboard": "bin/sketchboard.js"
  },
  "files": [
    "bin",
    "src",
    "ui"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.browser.json",
    "test:e2e": "playwright test --pass-with-no-tests"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
